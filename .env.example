# ========== 大模型 + 向量化：硅基流动一个 Key 全搞定 ==========
# 获取地址：https://cloud.siliconflow.cn → 账户管理 → API 密钥
# 问答模型 DeepSeek-V4-Flash（支持工具调用），embedding 用免费 BAAI/bge-m3
LLM_API_KEY=sk-在这里填你的硅基流动Key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ========== Embedding（可选）==========
# 模式选择：local=本地哈希（关键词命中稳、零成本）/ bge=硅基流动语义向量
# 本项目是短知识条目，实测 local 对"牙齿掉落/考试焦虑"这类冷门词命中更准；
# bge 语义泛化强但对短词区分度弱。面试可两种都试，对比讲解。
EMBEDDING_MODE=local

# BAAI/bge-m3 在硅基流动免费。
# 留空 = 自动复用上面的 LLM_API_KEY（同一个 Key 即可，不用填两遍）；
# 也可以单独填一个，以这里的值为准。
# 若两处都不填或 LLM 不是硅基流动，则用本地哈希向量兜底，零成本跑通链路。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ========== 检索参数 ==========
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# 混合检索：BM25（字面精确）+ 向量（语义泛化），RRF 融合
ENABLE_BM25=1       # 1=混合检索（推荐）/ 0=纯向量（对照用）
RRF_C=60            # RRF 融合常数，一般不用改
MIN_VEC_SCORE=0.18  # BM25 全 0 且向量分低于此值 -> 判定未命中，交给模型兜底

# 每库独立 Top-K（不填则用默认值：心理学 2、易经 3）
TOP_K_心理学=2
TOP_K_易经=3
